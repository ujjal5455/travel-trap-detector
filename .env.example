# Copy to .env.local and fill in. Every service below has a free tier with no card required.
# All values are server-only: never prefix with NEXT_PUBLIC_.

SUPABASE_URL=
SUPABASE_SECRET_KEY=                            # service role / secret key
ORS_API_KEY=                                    # openrouteservice.org (optional: falls back to Haversine x 1.3)
LLM_BASE_URL=https://api.groq.com/openai/v1     # any OpenAI-compatible endpoint
LLM_API_KEY=                                    # optional: free key from console.groq.com; template used if empty
LLM_MODEL=llama-3.3-70b-versatile               # check Groq's current model list
